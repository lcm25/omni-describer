#: audio_describer/__app__real.py:108
#, python-format
msgid "%(app_name)s started."
msgstr "%(app_name)s iniciado."

#: audio_describer/__app__real.py:127
#, python-format
msgid ""
"Omni Describer is now available as a web platform!\n"
"\n"
"The desktop app will continue to work, but new features and improvements are now focused on the web version at:\n"
"\n"
"%(webapp_url)s\n"
"\n"
"The web platform requires no installation, no API keys, and works on all devices including Mac and mobile.\n"
"\n"
"Would you like to open the web platform now?\n"
"\n"
"(This message will only be shown once.)"
msgstr ""
"O Omni Describer agora também existe como plataforma web!\n"
"\n"
"O aplicativo para computador continua funcionando, mas os recursos novos e as melhorias estão na versão web:\n"
"\n"
"%(webapp_url)s\n"
"\n"
"A plataforma web não precisa de instalação nem de chave de API e funciona em todos os aparelhos, inclusive Mac e celular.\n"
"\n"
"Quer abrir a plataforma web agora?\n"
"\n"
"(Esta mensagem aparece só uma vez.)"

#: audio_describer/__app__real.py:140
msgid "Omni Describer Web Platform"
msgstr "Plataforma web do Omni Describer"

